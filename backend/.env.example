# RichLead Backend Environment Variables (Example Template)

# --- Django Settings ---
SECRET_KEY=generate-a-unique-production-secret
DEBUG=False
# Comma-separated hostnames Django will serve (no wildcards in production)
ALLOWED_HOSTS=app.example.com,api.example.com
# Comma-separated origins allowed to call the API from a browser
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com,https://api.example.com
BACKEND_URL=https://api.example.com
FRONTEND_URL=https://richlead.elevabel.com
# Use postgresql://USER:PASSWORD@HOST:5432/DBNAME (encode URL-special password chars).
DATABASE_URL=postgresql://richlead:replace-me@127.0.0.1:5432/richlead
DATABASE_SSLMODE=disable

# --- Background jobs ---
# Keep Redis bound to localhost/private networking; never expose it publicly.
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Leave false in production. Local DEBUG mode runs tasks eagerly unless overridden.
CELERY_TASK_ALWAYS_EAGER=False

# --- Password reset mail (global sender; do not use per-user outreach mailboxes) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-reset-sender@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
PASSWORD_RESET_FROM_NAME=Rich Lead

# --- Credential Encryption ---
# Encrypts stored API keys, SMTP passwords and OAuth tokens.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: rotating this invalidates every stored credential -- users must re-enter them.
FERNET_KEY=your-fernet-key-here

# --- Google OAuth Credentials ---
# Generate from Google Cloud Console (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Microsoft OAuth Credentials ---
# Generate from Azure Portal (https://portal.azure.com/)
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common
