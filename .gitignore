# ==========================================
# RichLead Full-Stack .gitignore
# Next.js (Frontend) + Django (Backend)
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------
.env
.env*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.pem
*.key
*.cert

# ------------------------------------------
# Python & Django (Backend)
# ------------------------------------------
# Byte-compiled / cache files
__pycache__/
*.py[cod]
*$py.class

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/.venv/

# SQLite & Databases
*.sqlite3
*.db
db.sqlite3
backend/db.sqlite3

# Django media & static collections
media/
staticfiles/

# Python test, coverage, distribution
build/
dist/
*.egg-info/
.coverage
htmlcov/
.pytest_cache/

# ------------------------------------------
# Node.js & Next.js (Frontend)
# ------------------------------------------
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
out/
/coverage

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# TypeScript / Vercel
*.tsbuildinfo
next-env.d.ts
.vercel/

# ------------------------------------------
# Operating System & IDE Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ------------------------------------------
# Temporary / Scratch Files
# ------------------------------------------
requirements_temp.txt
test_*.py
backend/test_*.py
scratch/
